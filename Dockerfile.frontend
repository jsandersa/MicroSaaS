# =====================================================================
# Stage 1: Build Angular Application (Node.js LTS)
# =====================================================================
FROM node:22-alpine AS build
WORKDIR /app

# Instalar dependencias aprovechando la caché de Docker
COPY ["src/MicroSaaS.Web/package*.json", "./"]
RUN npm install

# Copiar código fuente del frontend y compilar en modo producción
COPY ["src/MicroSaaS.Web/", "./"]
RUN npm run build -- --configuration production

# =====================================================================
# Stage 2: Serve with NGINX (Alpine)
# =====================================================================
FROM nginx:alpine AS final

# Copiar configuración personalizada de NGINX (SPA routing + Reverse Proxy /api -> api:8080)
COPY ["src/MicroSaaS.Web/nginx.conf", "/etc/nginx/conf.d/default.conf"]

# Copiar artefactos compilados de Angular al directorio público de NGINX
COPY --from=build /app/dist/micro-saas-web/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

